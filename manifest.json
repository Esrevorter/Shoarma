{
  "manifest_version": 3,
  "name": "Shoarma",
  "version": "0.9.12",
  "background": {
    "service_worker": "swarm-engine.js"
  },
  "description": "Bridges two authenticated LLM web UIs into a self-driving conversation \u2014 fully browser-based.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shoarma \u2014 LLM Bridge control deck",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "bridge.js"
      ],
      "css": [
        "hud.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "hud.css"
      ],
      "matches": [
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*"
  ]
}
